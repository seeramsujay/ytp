#!/usr/bin/env bash
# ytp — Ultimate YouTube Playlist & Video Downloader CLI
# Simplify yt-dlp downloads with saved playlist aliases, format listing, and range selection.

VERSION="1.2.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ytp"
PLAYLISTS_FILE="$CONFIG_DIR/playlists"

# ANSI Color Codes
BOLD="\033[1m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
CYAN="\033[0;36m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
MAGENTA="\033[0;35m"
RESET="\033[0m"

# Ensure config directory exists
init_config() {
    if [[ ! -d "$CONFIG_DIR" ]]; then
        mkdir -p "$CONFIG_DIR"
    fi
    if [[ ! -f "$PLAYLISTS_FILE" ]]; then
        touch "$PLAYLISTS_FILE"
    fi
}

# Verify yt-dlp is installed
check_yt_dlp() {
    if ! command -v yt-dlp &>/dev/null; then
        echo -e "${RED}Error:${RESET} ${BOLD}yt-dlp${RESET} is not installed or not in PATH."
        echo -e "Please install it using your package manager or pip/uv:"
        echo -e "  ${CYAN}pip install yt-dlp${RESET}  or  ${CYAN}sudo apt install yt-dlp${RESET}"
        exit 1
    fi
}

# Display Help Page
show_help() {
    echo -e "${BOLD}${CYAN}ytp${RESET} — ${BLUE}YouTube Playlist & Media Downloader Helper${RESET} (${YELLOW}v${VERSION}${RESET})"
    echo
    echo -e "${BOLD}USAGE:${RESET}"
    echo -e "  ${GREEN}ytp${RESET} ${CYAN}<url_or_alias>${RESET} ${YELLOW}[range]${RESET} ${MAGENTA}[format]${RESET}       Download playlist items"
    echo -e "  ${GREEN}ytp${RESET} ${BOLD}--save${RESET} ${CYAN}<link>${RESET} ${YELLOW}<alias_name>${RESET}        Save a playlist for quick access"
    echo -e "  ${GREEN}ytp${RESET} ${BOLD}--list-saved${RESET}                          List all saved playlist aliases"
    echo -e "  ${GREEN}ytp${RESET} ${BOLD}--remove${RESET} ${YELLOW}<alias_name>${RESET}               Delete a saved playlist alias"
    echo -e "  ${GREEN}ytp${RESET} ${BOLD}-F${RESET} | ${BOLD}--list-formats${RESET} ${CYAN}<url_or_alias>${RESET}    List available formats for a video/playlist"
    echo -e "  ${GREEN}ytp${RESET} ${BOLD}-V${RESET} | ${BOLD}--list-videos${RESET} ${CYAN}<url_or_alias>${RESET} ${YELLOW}[range]${RESET} List video titles in a playlist"
    echo -e "  ${GREEN}ytp${RESET} ${BOLD}-h${RESET} | ${BOLD}--help${RESET}                          Show this help page"
    echo -e "  ${GREEN}ytp${RESET} ${BOLD}-v${RESET} | ${BOLD}--version${RESET}                       Display ytp version"
    echo
    echo -e "${BOLD}ARGUMENTS:${RESET}"
    echo -e "  ${CYAN}<url_or_alias>${RESET}   YouTube playlist/video URL or a saved alias name."
    echo -e "  ${YELLOW}[range]${RESET}          Items to download or list. Examples: ${YELLOW}3-6${RESET}, ${YELLOW}7${RESET}, ${YELLOW}1,3,5${RESET}, ${YELLOW}1-10${RESET}, ${YELLOW}all${RESET} (Default: ${YELLOW}1-${RESET})"
    echo -e "  ${MAGENTA}[format]${RESET}         yt-dlp format code (e.g. ${MAGENTA}18${RESET}, ${MAGENTA}bestvideo+bestaudio/best${RESET})."
    echo -e "                   If omitted, defaults to standard format or lists options."
    echo
    echo -e "${BOLD}EXAMPLES:${RESET}"
    echo -e "  ${BLUE}# Save a playlist link with a shortcut name:${RESET}"
    echo -e "  ytp --save \"https://www.youtube.com/playlist?list=PLabc123\" mysongs"
    echo
    echo -e "  ${BLUE}# Download items 1 through 5 using the saved alias:${RESET}"
    echo -e "  ytp mysongs 1-5"
    echo
    echo -e "  ${BLUE}# Download item 7 from direct URL:${RESET}"
    echo -e "  ytp \"https://www.youtube.com/playlist?list=PLabc123\" 7"
    echo
    echo -e "  ${BLUE}# List video titles in a playlist:${RESET}"
    echo -e "  ytp --list-videos mysongs"
    echo
    echo -e "  ${BLUE}# List available format codes for a playlist/video:${RESET}"
    echo -e "  ytp -F mysongs"
    echo
    echo -e "  ${BLUE}# Download range 1-10 with specific 360p format code (18):${RESET}"
    echo -e "  ytp mysongs 1-10 18"
    echo
}

# Display Version
show_version() {
    echo -e "${BOLD}ytp${RESET} version ${YELLOW}${VERSION}${RESET}"
}

# Save a playlist alias
save_playlist() {
    init_config
    local url="$1"
    local alias_name="$2"

    if [[ -z "$url" || -z "$alias_name" ]]; then
        echo -e "${RED}Error:${RESET} Missing arguments for --save."
        echo -e "Usage: ${GREEN}ytp --save <url> <alias_name>${RESET}"
        exit 1
    fi

    # Remove existing alias if it exists
    if grep -q "^${alias_name}=" "$PLAYLISTS_FILE" 2>/dev/null; then
        sed -i "/^${alias_name}=/d" "$PLAYLISTS_FILE"
    fi

    echo "${alias_name}=${url}" >> "$PLAYLISTS_FILE"
    echo -e "${GREEN}✓ Saved playlist alias:${RESET} ${YELLOW}${alias_name}${RESET} -> ${CYAN}${url}${RESET}"
}

# List all saved playlists
list_saved_playlists() {
    init_config
    echo -e "${BOLD}${CYAN}Saved Playlist Aliases:${RESET}"
    if [[ ! -s "$PLAYLISTS_FILE" ]]; then
        echo -e "  ${YELLOW}(No playlists saved yet. Use: ytp --save <url> <alias_name>)${RESET}"
        return
    fi
    echo -e "--------------------------------------------------------"
    while IFS='=' read -r alias_name url; do
        [[ -z "$alias_name" || "$alias_name" =~ ^# ]] && continue
        printf "  ${BOLD}%-15s${RESET} -> %s\n" "$alias_name" "$url"
    done < "$PLAYLISTS_FILE"
    echo -e "--------------------------------------------------------"
}

# Remove a saved playlist alias
remove_playlist() {
    init_config
    local alias_name="$1"

    if [[ -z "$alias_name" ]]; then
        echo -e "${RED}Error:${RESET} Missing alias name to remove."
        echo -e "Usage: ${GREEN}ytp --remove <alias_name>${RESET}"
        exit 1
    fi

    if grep -q "^${alias_name}=" "$PLAYLISTS_FILE" 2>/dev/null; then
        sed -i "/^${alias_name}=/d" "$PLAYLISTS_FILE"
        echo -e "${GREEN}✓ Removed playlist alias:${RESET} ${YELLOW}${alias_name}${RESET}"
    else
        echo -e "${RED}Error:${RESET} Playlist alias '${YELLOW}${alias_name}${RESET}' not found."
    fi
}

# Resolve URL or alias
resolve_url() {
    local target="$1"
    init_config

    # Check if target looks like a URL
    if [[ "$target" =~ ^https?:// ]] || [[ "$target" =~ ^www\. ]] || [[ "$target" =~ ^youtube\.com ]] || [[ "$target" =~ ^youtu\.be ]]; then
        echo "$target"
        return 0
    fi

    # Check config file for saved alias
    if [[ -f "$PLAYLISTS_FILE" ]]; then
        local stored_url
        stored_url=$(grep "^${target}=" "$PLAYLISTS_FILE" | head -n 1 | cut -d'=' -f2-)
        if [[ -n "$stored_url" ]]; then
            echo "$stored_url"
            return 0
        fi
    fi

    # Alias not found and not a URL
    echo -e "${RED}Error:${RESET} Could not resolve '${YELLOW}${target}${RESET}' as a URL or saved alias." >&2
    echo -e "Run ${GREEN}ytp --list-saved${RESET} to check your saved playlists." >&2
    exit 1
}

# List available formats for a video/playlist
list_formats() {
    check_yt_dlp
    local target="$1"

    if [[ -z "$target" ]]; then
        echo -e "${RED}Error:${RESET} Please provide a URL or saved alias to list formats."
        echo -e "Usage: ${GREEN}ytp -F <url_or_alias>${RESET}"
        exit 1
    fi

    local resolved_url
    resolved_url=$(resolve_url "$target") || exit 1

    echo -e "${BOLD}${CYAN}Fetching available formats for:${RESET} ${YELLOW}${target}${RESET}"
    echo -e "${BLUE}${resolved_url}${RESET}"
    echo -e "--------------------------------------------------------"

    # Run yt-dlp -F for the first playlist item or target URL
    yt-dlp -F --playlist-items 1 "$resolved_url"
}

# List video titles in a playlist
list_videos() {
    check_yt_dlp
    local target="$1"
    local item_range="${2:-1-}"

    if [[ -z "$target" ]]; then
        echo -e "${RED}Error:${RESET} Please provide a URL or saved alias to list video titles."
        echo -e "Usage: ${GREEN}ytp --list-videos <url_or_alias> [range]${RESET}"
        exit 1
    fi

    if [[ "$item_range" == "all" ]]; then
        item_range="1-"
    fi

    local resolved_url
    resolved_url=$(resolve_url "$target") || exit 1

    echo -e "${BOLD}${CYAN}Fetching video titles for:${RESET} ${YELLOW}${target}${RESET}"
    echo -e "${BLUE}${resolved_url}${RESET}"
    echo -e "--------------------------------------------------------"

    yt-dlp --flat-playlist --playlist-items "$item_range" --print title "$resolved_url"
}

# Main script logic
main() {
    # Check for empty args
    if [[ "$#" -eq 0 ]]; then
        show_help
        exit 0
    fi

    # Parse Flags & Commands
    case "$1" in
        -h|--help|help)
            show_help
            exit 0
            ;;
        -v|--version|version)
            show_version
            exit 0
            ;;
        --save|-s|save)
            save_playlist "$2" "$3"
            exit 0
            ;;
        --list-saved|-l|list)
            list_saved_playlists
            exit 0
            ;;
        --remove|-r|remove)
            remove_playlist "$2"
            exit 0
            ;;
        -F|--list-formats|formats)
            list_formats "$2"
            exit 0
            ;;
        -V|--list-videos|videos)
            list_videos "$2" "$3"
            exit 0
            ;;
    esac

    # Positional Execution: ytp <url_or_alias> [range] [format]
    check_yt_dlp

    local target="$1"
    local item_range="${2:-1-}"
    local format="$3"

    if [[ "$item_range" == "all" ]]; then
        item_range="1-"
    fi

    local playlist_url
    playlist_url=$(resolve_url "$target") || exit 1

    echo -e "${BOLD}${CYAN}ytp Downloader${RESET}"
    echo -e "${BOLD}Target:${RESET}         ${YELLOW}${target}${RESET} (${playlist_url})"
    echo -e "${BOLD}Items Range:${RESET}    ${GREEN}${item_range}${RESET}"
    
    if [[ -n "$format" ]]; then
        echo -e "${BOLD}Format Code:${RESET}    ${MAGENTA}${format}${RESET}"
    else
        echo -e "${BOLD}Format Code:${RESET}    ${YELLOW}Default (Best Quality / Standard)${RESET}"
        echo -e "${BLUE}Tip:${RESET} To view all available format codes, run: ${GREEN}ytp -F ${target}${RESET}"
    fi
    echo -e "--------------------------------------------------------"

    # Output pattern with two-digit index: 01 - Video Title.mp4
    local output_pattern="%(playlist_index)02d - %(title)s.%(ext)s"

    # Build yt-dlp command array
    local cmd_args=(-o "$output_pattern" --playlist-items "$item_range")
    if [[ -n "$format" ]]; then
        cmd_args+=(-f "$format")
    fi
    cmd_args+=("$playlist_url")

    # Run yt-dlp
    yt-dlp "${cmd_args[@]}"
}

main "$@"
